{
  "name": "invoice-approval-gate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/*.test.ts && playwright test",
    "test:unit": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:claims": "playwright test tests/e2e/claims.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.58.2"
    }
  }
}
